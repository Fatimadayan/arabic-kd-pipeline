all_prompts = json.loads(HABASH_DATA)
DIALECT_ID  = all_prompts["dialect_id"]
NORMALIZE   = all_prompts["normalize"]
CODE_SWITCH = all_prompts["code_switch"]

# Use 100 per category for fast eval (300 total per model)
# Full 1000 per category takes ~8h per model — use 100 for this run
SAMPLE = 100
import random; random.seed(42)
DID  = random.sample(DIALECT_ID,  SAMPLE)
NORM = random.sample(NORMALIZE,   SAMPLE)
CS   = random.sample(CODE_SWITCH, SAMPLE)

def has_cjk(text):
    return any('\u4e00' <= c <= '\u9fff' or '\uac00' <= c <= '\ud7a3' for c in text)

def load_model(ckpt):
    bnb = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_compute_dtype=torch.bfloat16)
    tok = AutoTokenizer.from_pretrained(BASE, token=TOKEN)
    base = AutoModelForCausalLM.from_pretrained(
        BASE, quantization_config=bnb, device_map={"":0}, token=TOKEN)
    model = PeftModel.from_pretrained(base, ckpt) if ckpt else base
    model.eval()
    return tok, model

def gen(tok, model, q, max_new=100):
    msgs = [{"role":"user","content":q}]
    text = tok.apply_chat_template(msgs, tokenize=False, add_generation_prompt=True)
    inputs = tok(text, return_tensors="pt", truncation=True, max_length=512).to("cuda:0")
    with torch.no_grad():
        out = model.generate(**inputs, max_new_tokens=max_new, do_sample=False,
                             pad_token_id=tok.eos_token_id)
    return tok.decode(out[0][inputs["input_ids"].shape[1]:], skip_special_tokens=True).strip()

def score_item(resp, kws):
    if has_cjk(resp): return False
    if len(resp.strip()) < 10: return False
    resp_lower = resp.lower()
    return any(k.lower() in resp_lower for k in kws)

all_results = {}

for model_name, ckpt in CKPTS.items():
    print(f"\n{'='*55}")
    print(f"Evaluating: {model_name}")
    print(f"{'='*55}")
    if ckpt and not os.path.exists(ckpt+"/adapter_config.json"):
        print("SKIP — checkpoint not found"); continue

    tok, model = load_model(ckpt)

    did_ok=0; norm_ok=0; cs_ok=0; cjk_total=0
    details = []

    # Dialect ID
    for item in tqdm(DID, desc="Dialect ID"):
        resp = gen(tok, model, item["q"])
        cjk  = has_cjk(resp)
        ok   = score_item(resp, item["kw"])
        if cjk: cjk_total += 1
        if ok: did_ok += 1
        details.append({"cat":"dialect_id","q":item["q"][:80],
                        "resp":resp[:120],"ok":ok,"cjk":cjk})

    # Normalization
    for item in tqdm(NORM, desc="Normalize"):
        resp = gen(tok, model, item["q"])
        cjk  = has_cjk(resp)
        ok   = score_item(resp, item["kw"])
        if cjk: cjk_total += 1
        if ok: norm_ok += 1
        details.append({"cat":"normalize","q":item["q"][:80],
                        "resp":resp[:120],"ok":ok,"cjk":cjk})

    # Code-switch
    for item in tqdm(CS, desc="Code-Switch"):
        resp = gen(tok, model, item["q"])
        cjk  = has_cjk(resp)
        ok   = score_item(resp, item["kw"])
        if cjk: cjk_total += 1
        if ok: cs_ok += 1
        details.append({"cat":"code_switch","q":item["q"][:80],
                        "resp":resp[:120],"ok":ok,"cjk":cjk})

    n = SAMPLE
    did_pct  = round(did_ok/n*100, 1)
    norm_pct = round(norm_ok/n*100, 1)
    cs_pct   = round(cs_ok/n*100, 1)
    overall  = round((did_ok+norm_ok+cs_ok)/(n*3)*100, 1)
    cjk_rate = round(cjk_total/(n*3)*100, 1)

    print(f"\n  Dialect ID:    {did_pct}% ({did_ok}/{n})")
    print(f"  Normalize:     {norm_pct}% ({norm_ok}/{n})")
    print(f"  Code-Switch:   {cs_pct}% ({cs_ok}/{n})")
    print(f"  Overall:       {overall}%")
    print(f"  CJK failures:  {cjk_total}/{n*3} ({cjk_rate}%)")

    all_results[model_name] = {
        "dialect_id": did_pct, "normalize": norm_pct,
        "code_switch": cs_pct, "overall": overall,
        "cjk_failures": cjk_total, "cjk_rate": cjk_rate,
        "n_per_category": n, "details": details[:30]
    }
    del model; torch.cuda.empty_cache()

with open(OUT, "w", encoding="utf-8") as f:
    json.dump(all_results, f, ensure_ascii=False, indent=2)

print(f"\n\n{'='*70}")
print("HABASH CORPUS EVALUATION — FINAL TABLE")
print("(100 real Bahraini sentences per category, CJK-filtered scoring)")
print(f"{'='*70}")
print(f"{'Model':<18} {'Dialect ID%':>12} {'Normalize%':>11} {'Code-Switch%':>13} {'Overall%':>9} {'CJK%':>7}")
print("-"*74)
for name, res in all_results.items():
    star = " *" if "selectkd" in name else ""
    print(f"{name+star:<20} {str(res['dialect_id'])+'%':>12} {str(res['normalize'])+'%':>11} {str(res['code_switch'])+'%':>13} {str(res['overall'])+'%':>9} {str(res['cjk_rate'])+'%':>7}")
print(f"\nSaved to: {OUT}")
print(f"Completed at: $(date)")
INNEREOF
